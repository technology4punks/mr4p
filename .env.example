# Set secrets in the host runtime; never commit a populated .env.
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
PORT=3000
# REQUIRED in production: exact HTTPS origin, and reverse-proxy authentication.
# Example production origin: https://your-host.example
# Empty in local development permits localhost origins.
APP_ORIGIN=
# Production token endpoint fails closed unless this is true AND trusted proxy
# strips incoming X-NEO-USER and sets it only after authenticating the visitor.
REQUIRE_PROXY_AUTH=false
# Server/proxy shared secret; required when proxy auth is enabled.
PROXY_AUTH_SECRET=
# Exact number of trusted reverse-proxy hops; 0 for direct access.
TRUST_PROXY_HOPS=0
TOKEN_LIMIT_PER_MINUTE=5
TOKEN_GLOBAL_LIMIT_PER_MINUTE=30

FUTURE_DB_PATH=./data/future-observatory.sqlite
RETENTION_DAYS=30
